# DisasterShield Mobile - Environment Configuration
# NOTE: The application operates 100% out-of-the-box in self-contained demo mode
# with zero external API keys required. You can optionally supply your own keys below.

# --- Optional AI & Speech Services ---
# Gemini API Key for dynamic multi-lingual crisis analysis
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional Meteorological Telemetry ---
# OpenWeatherMap API Key for live weather synchronization
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Map Configuration ---
# DisasterShield defaults to OpenStreetMap (OSM) free raster tiles (Zero Key Required).
# If switching to Mapbox raster/vector layers, provide your public token:
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
