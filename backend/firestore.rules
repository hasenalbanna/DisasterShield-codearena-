rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles & Trust Scoring
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Live Hazard Reports
    match /hazards/{hazardId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'crew');
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Emergency SOS Cases
    match /cases/{caseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'crew');
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Municipal Council Work Orders
    match /tickets/{ticketId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'crew');
    }
    
    // Ward-level Broadcast Alerts & Evacuation Advisories
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Relief Centers & Shelter Capacities
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'crew');
    }
  }
}
